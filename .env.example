# ============================================================================
# Horizon Scanner — environment variables
# Copy this file to `.env` and fill in real values for local dev.
# See README.md for the full deployment architecture and setup instructions.
# ============================================================================

# --- Supabase (self-hosted stack — see README for setup) ---
# Kong/PostgREST gateway URL. Point at your local or hosted Supabase instance.
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=<self-hosted anon JWT>
SUPABASE_SERVICE_ROLE_KEY=<self-hosted service role JWT>

# Frontend duplicates of the above (Vite needs the VITE_ prefix at build time)
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_KEY=<same anon JWT>
VITE_API_BASE_URL=/api

# --- LiteLLM proxy (Qwen 2.5 14B + embeddings) ---
# Proxy lives on CT 131 (https://llm.iotaimpact.com). REQUIRED — without it,
# the LLM client disables itself silently and search returns 0 papers.
LLM_BASE_URL=https://llm.iotaimpact.com
LLM_API_KEY=<litellm master_key — REQUIRED>

# Generation model (extraction, query expansion, chat, LLM judge).
# 2026-05-20: LiteLLM proxy now exposes only qwen2.5:14b-synthesis as the
# general-purpose LLM. The previous default qwen2.5:14b-synthesis was
# removed. Override here if DevOps re-adds the 7b alias.
LLM_MODEL=qwen2.5:14b-synthesis

# Embedding model. The corpus is 768-dim Nomic, originally embedded via
# Ollama (`nomic-embed-text`). The vLLM-served variant (`nomic-embed-text-vllm`)
# is now the default — verified compatible with the existing corpus (avg
# cosine 0.994 across sample re-embeds; see scripts/verify-embedding-compat.mjs).
# Note: vLLM returns un-normalised vectors but match_works uses pgvector's
# cosine `<=>` operator, which normalises internally. Override only if devops
# changes the LiteLLM model registration.
# Prod (2026-06-17): qwen3-embedding:8b-app — a DEDICATED-GPU instance of the
# qwen3-embedding:8b model (same 768-dim weights), isolated from the 14b chat model
# so embeds and chat don't evict each other on one GPU. Rollback: nomic-embed-text-vllm
# (requires the embedding_nomic_old column swap — see CLAUDE.md qwen-768 cutover).
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:8b-app
OLLAMA_GENERATION_MODEL=qwen2.5:14b-synthesis

# --- Direct/Indirect classifier (2026-05-13) ---
# When true, retrieval.ts calls Qwen-as-judge to label each candidate as
# direct / indirect / excluded. Falls back to the facet-cosine classifier
# per-paper if the LLM call fails. Adds ~1.6s latency for top-50 papers.
# Eval evidence: 90% agreement on partial bucket vs facet-cosine's 18% on
# the 459-paper labeled set (reports/qwen-judge-classifier-2026-05-13.md).
# Set false to disable and revert to facet-cosine only.
LLM_JUDGE_CLASSIFIER=true
# Parallel concurrency for the per-paper Qwen calls. 8 fits the LiteLLM
# token bucket for typical 1-2 queries/min. Raise only if rate-limit headroom
# allows (probe-ss-api-tier.mjs equivalent for LiteLLM not yet measured).
LLM_JUDGE_PARALLEL=8
# Cap on how many candidates the LLM-judge classifies (top-N by similarity).
# Tail uses cosine. Production routinely retrieves 400-500 candidates.
# 2026-05-13: bumped 60 → 100 → 200 across iterations. cap=200 measured at
# 37s in production (vs 75s gateway timeout). Each step from 60 → 100 → 200
# added ~3 + ~6 = 9 direct papers on the AI×labor query. If gateway timeouts
# return, lower to 150 or bump LLM_JUDGE_PARALLEL.
LLM_JUDGE_CAP=200

# --- Trained classifier (third tier, 2026-05-13) ---
# Logistic regression fitted on the 459-paper labeled set. Slots between the
# LLM judge (top-N) and the facet-cosine classifier (tail). Adds <100ms total
# for a few hundred papers. Off until verified — set true to enable.
# Quality on the 459-paper CV: 60% accuracy, 0.561 macro-F1.
# Failure mode: returns no classifications → cosine fallback is automatic.
TRAINED_CLASSIFIER=true
# Top-N by similarity that get trained-classifier treatment. Papers above
# llmJudgeCap and below this cap get the trained model; rest get cosine.
TRAINED_CLASSIFIER_CAP=200

# --- Synthesis ---
# Gemini for the 5-section brief. App falls back to deterministic synthesis
# if missing, but quality is worse — set this in prod.
GEMINI_API_KEY=<gemini key>
# GEMINI_MODEL is intentionally left UNSET: the app default lives in code
# (supabase/functions/_shared/llmConfig.ts -> DEFAULT_GEMINI_MODEL, currently
# gemini-flash-latest). Only set this to override the code default — a stale pin
# here beats the default and can silently point prod at a retired model (the bare
# `gemini-2.5-flash` alias was retired by Google 2026-07-09 -> hard 404).
# GEMINI_MODEL=gemini-flash-latest
#
# GEMINI_JEL_MODEL — the model that drafts JEL survey-paper SECTIONS specifically
# (separate from brief synthesis above). PROD default is gemini-pro-latest: on an
# A/B (2026-07-09) Pro produced clean, citation-grounded prose where flash leaked
# citation-scratchpad / per-section reference blocks, for ~4x the cost (~$0.10 ->
# ~$0.41+/paper; Pro thinking tokens bill as output). To go back to the cheaper,
# lower-quality drafter, set this to gemini-flash-latest (or unset -> code default).
GEMINI_JEL_MODEL=gemini-pro-latest
# GEMINI_JEL_QA_MODEL — model for the JEL QA/non-drafting passes (Devil's Advocate,
# coherence editor, claim audit, final review, corrector, revision routing). These
# don't need the drafter's prose quality, so they run on the cheaper flash model
# (default), keeping expensive Pro for SECTION drafting only (~halves Pro spend).
# Unset -> code default (gemini-flash-latest). Set to gemini-pro-latest to put QA back on Pro.
# GEMINI_JEL_QA_MODEL=gemini-flash-latest

# --- Optional: ingest / corpus expansion (only needed when running scripts) ---
SEMANTIC_SCHOLAR_API_KEY=<optional>
OPENALEX_EMAIL=<your@email>
EXA_API_KEY=<optional>
NOMIC_API_KEY=<optional, for direct Nomic API instead of LiteLLM>
GROK_API_KEY=<optional>
GROQ_API_KEY=<optional>

# --- Worker (CT 135 extraction worker only) ---
WORKER_BATCH_SIZE=2
WORKER_MAX_ATTEMPTS=3

# --- PostHog analytics (frontend) ---
# Browser-side product analytics. NO-OP when VITE_POSTHOG_KEY is absent.
# PRIVACY: events are scrubbed (services/analytics.ts scrubProps) — raw search
# query text is NEVER sent. Only counts / channels / persona / latency.
VITE_POSTHOG_KEY=<posthog project api key>
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry (frontend) — Phase 3 visibility ---
# Browser exception capture. NO-OP without VITE_SENTRY_DSN (no @sentry/browser
# dependency — thin fetch-based capture). Wired into the React ErrorBoundary.
VITE_SENTRY_DSN=<sentry browser DSN, optional>
VITE_SENTRY_ENV=production

# ============================================================================
# Phase 3 "Visibility" — server-side telemetry + external sinks (Deno API)
# ============================================================================

# --- First-party telemetry (own VPS Postgres) ---
# Writes to public.llm_calls + public.usage_events (migration 20260603000001).
# Fail-safe: if the tables are absent or the DB is slow, inserts are swallowed
# and never block/slow a request. Set TELEMETRY_DISABLED=true to no-op all of it.
# TELEMETRY_DISABLED=false

# --- PostHog (server-side capture) — Phase 3 visibility ---
# Server mirror of scrubbed product/LLM events. NO-OP without POSTHOG_KEY.
# (Separate from the VITE_ frontend key — this is the server capture key.)
# PRIVACY: scrubForExternal() strips query text before any emit.
# POSTHOG_KEY=<posthog project api key (server)>
# POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry (server-side) — Phase 3 visibility ---
# Captures LLM error/timeout + unhandled API exceptions. NO-OP without SENTRY_DSN.
# SENTRY_DSN=<sentry DSN, optional>
# SENTRY_ENV=production

# --- Deno API server (CT 134 only) ---
DENO_API_PORT=3002

# --- BYOK synthesis (admin-provisioned provider keys) ---
# AES-256-GCM master key for encrypting admin BYOK provider keys at rest
# (synthesis_keys.enc_key). 32 raw bytes, base64. Generate: openssl rand -base64 32
# Without it, the synthesis-keys endpoints throw on encrypt/decrypt (feature off);
# the app-default Gemini path is unaffected.
# SYNTHESIS_KEY_SECRET=<base64 of 32 random bytes>
